generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String          @id @default(uuid())
  userName           String
  email              String          @unique
  password           String
  otp           String?
  otpExpiry     DateTime?

  mobileNumber       String?
  state              String?
  district           String?
  pincode            String?
  verified           Boolean          @default(false)
  isProfileCompleted Boolean         @default(false)
  refreshTokenHash   String?
  failedLoginAttempts Int            @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  requests           RentalRequest[]
  vehicles           Vehicle[]
  reviewsGiven       Review[]    @relation("ReviewReviewer")
  reviewsReceived    Review[]    @relation("ReviewReviewee")
}

model Vehicle {
  id          String          @id @default(uuid())
  ownerId     String
  plateNumber String          @unique
  brand       String
  model       String
  type        String
  pricePerDay Int
  location    String
  description String
  imageUrl    String
  isAvailable Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  requests    RentalRequest[]
  owner       User            @relation(fields: [ownerId], references: [id])
}

model RentalRequest {
  id        String        @id @default(uuid())
  senderId  String
  vehicleId String
  startDate DateTime
  endDate   DateTime
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sender    User          @relation(fields: [senderId], references: [id])
  vehicle   Vehicle       @relation(fields: [vehicleId], references: [id])
  review    Review?
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Review {
  id            String   @id @default(uuid())
  rentalRequestId String
  reviewerId    String
  revieweeId    String
  rating        Int      @default(5)
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rentalRequest RentalRequest @relation(fields: [rentalRequestId], references: [id])
  reviewer      User          @relation("ReviewReviewer", fields: [reviewerId], references: [id])
  reviewee      User          @relation("ReviewReviewee", fields: [revieweeId], references: [id])

  @@unique([rentalRequestId])
}
